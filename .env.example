SENTINELX_ENV=dev
SENTINELX_DB_PATH=./data/sentinelx.db
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM Advisory Summarizer (Phase 8)
# The API key must live only in an untracked env file (e.g. services/api/.env.local).
# Never log the key, never commit it, and never expose it to frontend clients.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

