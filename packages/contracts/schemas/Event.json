    "Domain": {
      "description": "Network and asset operational domain.",
      "enum": [
        "it",
        "ot",
        "decoy"
      ],
      "title": "Domain",
      "type": "string"
    },
    "OTFields": {
      "additionalProperties": false,
      "description": "Operational Technology (OT/ICS) specific telemetry attributes.",
      "properties": {
        "unit_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Id"
        },
        "device_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Id"
        },
        "function_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Function Code"
        },
        "register": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Register"
        },
        "value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "is_write": {
          "title": "Is Write",
          "type": "boolean"
        }
      },
      "required": [
        "is_write"
      ],
      "title": "OTFields",
      "type": "object"
    },
    "Outcome": {
      "description": "Action execution outcome.",
      "enum": [
        "success",
        "failure",
        "unknown"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "SourceTool": {
      "description": "Telemetry collection and deception source tools.",
      "enum": [
        "wazuh",
        "zeek",
        "cowrie",
        "opencanary",
        "modbus",
        "evtx",
        "generic"
      ],
      "title": "SourceTool",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Normalized security event schema produced by all telemetry adapters.",
